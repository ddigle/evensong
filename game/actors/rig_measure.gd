class_name RigMeasure
extends RefCounted
## Measures the per-frame torso / head anchors of the base body sheets (● R27, brief §5.6):
## for every frame, the move within +/-radius under which the most pixels of walk frame 0's band
## find a pixel of similar colour (sum of RGB differences < RigData.ANCHOR_TOLERANCE). Both frames
## are compared in v01 coordinates (each sheet un-shifted by its own v01 -> v02 re-pivot), because
## the signature layers were drawn on walk v01 frame 0. Ties prefer the smaller move, then the
## first one in scan order (dy, then dx, ascending).
##
## tools/build_rig_anchors.gd writes the result to actors/rig_anchors.gd; tests/test_actors.gd
## measures again and compares, so a changed sheet fails the test instead of drifting.
## Reads the imported textures (lossless) with get_image(), so it also works in an exported build.


class Pixel:
	extends RefCounted
	var x: int
	var y_v01: int
	var r: int
	var g: int
	var b: int


static func sheet_data(anim: int) -> Image:
	var img: Image = RigData.sheet(anim).get_image()
	if img.is_compressed():
		img.decompress()
	img.convert(Image.FORMAT_RGBA8)
	return img


## Opaque pixels of walk frame 0 (sheet row) whose v01 row lies in `band`.
static func reference_pixels(walk: Image, row: int, band: Vector2i) -> Array[Pixel]:
	var out: Array[Pixel] = []
	var shift: int = RigData.shift(RigData.Anim.WALK, row)
	var h: int = Config.CHAR_FRAME.y
	for y_v01: int in range(band.x, band.y + 1):
		var y: int = y_v01 + shift
		if y < 0 or y >= h:
			continue
		for x: int in Config.CHAR_FRAME.x:
			var c: Color = walk.get_pixel(x, row * h + y)
			if c.a8 == 0:
				continue
			var p: Pixel = Pixel.new()
			p.x = x
			p.y_v01 = y_v01
			p.r = c.r8
			p.g = c.g8
			p.b = c.b8
			out.append(p)
	return out


## Anchor offsets of every frame of `anim` for a sheet row and band.
static func measure(anim: int, row: int, band: Vector2i, radius: int, walk: Image = null, sheet: Image = null) -> Array[Vector2i]:
	if walk == null:
		walk = sheet_data(RigData.Anim.WALK)
	if sheet == null:
		sheet = walk if anim == RigData.Anim.WALK else sheet_data(anim)
	var ref: Array[Pixel] = reference_pixels(walk, row, band)
	var shift: int = RigData.shift(anim, row)
	var w: int = Config.CHAR_FRAME.x
	var h: int = Config.CHAR_FRAME.y
	var tol: int = RigData.ANCHOR_TOLERANCE
	var out: Array[Vector2i] = []
	for f: int in RigData.frame_count(anim):
		var data: PackedByteArray = sheet.get_region(RigData.body_rect(row, f)).get_data()
		var best: Vector2i = Vector2i.ZERO
		var best_score: int = -1
		var best_dist: int = 1 << 20
		for dy: int in range(-radius, radius + 1):
			for dx: int in range(-radius, radius + 1):
				var score: int = 0
				for p: Pixel in ref:
					var x: int = p.x + dx
					var y: int = p.y_v01 + shift + dy
					if x < 0 or y < 0 or x >= w or y >= h:
						continue
					var i: int = (y * w + x) * 4
					if data[i + 3] == 0:
						continue
					if absi(data[i] - p.r) + absi(data[i + 1] - p.g) + absi(data[i + 2] - p.b) < tol:
						score += 1
				var dist: int = absi(dx) + absi(dy)
				if score > best_score or (score == best_score and dist < best_dist):
					best_score = score
					best_dist = dist
					best = Vector2i(dx, dy)
		out.append(best)
	return out


## Full table: [anim][row] -> Array[Vector2i] per frame, for the torso or head band.
static func measure_all(part: StringName) -> Array[Array]:
	var walk: Image = sheet_data(RigData.Anim.WALK)
	var band: Vector2i = RigData.HEAD_BAND if part == RigData.ANCHOR_HEAD else RigData.TORSO_BAND
	var radius: int = RigData.HEAD_RADIUS if part == RigData.ANCHOR_HEAD else RigData.TORSO_RADIUS
	var out: Array[Array] = []
	for anim: int in RigData.ANIM_NAMES.size():
		var sheet: Image = walk if anim == RigData.Anim.WALK else sheet_data(anim)
		var rows: Array = []
		for row: int in RigData.ROWS:
			rows.append(measure(anim, row, band, radius, walk, sheet))
		out.append(rows)
	return out


## GDScript source of actors/rig_anchors.gd for the measured tables.
static func anchors_source(torso: Array[Array], head: Array[Array]) -> String:
	var lines: PackedStringArray = [
		"class_name RigAnchors",
		"extends RefCounted",
		"## GENERATED by tools/build_rig_anchors.gd from art/chars/base_body_v02_{walk,idle}.png",
		"## (actors/rig_measure.gd). Do not edit by hand: run the tool and commit. tests/test_actors.gd",
		"## measures again and fails if this file is out of date.",
		"##",
		"## [anim (walk, idle)][sheet row (south, east, north)][frame] -> offset of the torso / head",
		"## band against walk frame 0, in px.",
		"",
	]
	lines.append("const TORSO: Array[Array] = %s" % _table_text(torso))
	lines.append("const HEAD: Array[Array] = %s" % _table_text(head))
	return "\n".join(lines) + "\n"


static func _table_text(table: Array[Array]) -> String:
	var anims: PackedStringArray = []
	for rows: Array in table:
		var row_texts: PackedStringArray = []
		for frames: Variant in rows:
			var items: PackedStringArray = []
			var list: Array = frames
			for v: Variant in list:
				var o: Vector2i = v
				items.append("Vector2i(%d, %d)" % [o.x, o.y])
			row_texts.append("\t\t[%s]," % ", ".join(items))
		anims.append("\t[\n%s\n\t]," % "\n".join(row_texts))
	return "[\n%s\n]" % "\n".join(anims)
